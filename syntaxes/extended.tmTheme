<?xml version="1.0" encoding="UTF-8"?>
<!--
	Name:		One Half Light (Enhanced Contrast)
	Author:		Son A. Pham <sp@sonpham.me> (Original)
	            Modified for increased contrast
	Url:		https://github.com/sonph/onehalf
	License:	The MIT License (MIT)

	A light Sublime Text color scheme based on Atom's One with enhanced contrast.

	Original Colors:
	Red: #e45649
	Green: #50a14f
	Yellow: #c18401
	Blue: #0184bc
	Purple: #a626a4
	Cyan: #0997b3
	White: #fafafa
	Black: #383a42
	Fg: #383a42
	Bg: #fafafa
	Comment: #a0a1a7

	Enhanced Colors:
	Red: #d01f0f
	Green: #2d7b2c
	Yellow: #9a6700
	Blue: #0069a1
	Purple: #880087
	Cyan: #037892
	White: #fafafa (unchanged)
	Black: #1f2328
	Fg: #1f2328
	Bg: #fafafa (unchanged)
	Comment: #787980
	Gutter foreground: #a0a0a0
	Selection: #a1c1ff

	Added Python-specific scopes for operators and keywords
-->
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>OneHalfLight-EnhancedContrast</string>
	<key>semanticClass</key>
	<string>theme.light.one_half_light</string>
	<key>uuid</key>
	<string></string>
	<key>colorSpaceName</key>
	<string>sRGB</string>
	<key>author</key>
	<string>Son A. Pham &lt;sp@sonpham.me&gt;</string>
	<key>comment</key>
	<string>A light iTerm color scheme based on Atom&apos;s One with enhanced contrast. See github.com&#x2f;sonph&#x2f;onehalf for installation instructions, a dark color scheme, and versions for other editors&#x2f;terminals such as (Neo)Vim and Sublime Text.</string>
	<key>settings</key>
	<array>
